{
  "name": "stan-fish lower",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  // "runArgs": ["--device=/dev/ttyUSB0", "--device=/dev/ttyACM0"],
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "kilocode.kilo-code"]
    }
  },
  "remoteUser": "fish"
}

// 工作区会被挂载到 /workspaces/lower 中，并安装环境与必要的工作区扩展
